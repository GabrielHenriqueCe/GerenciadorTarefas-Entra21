@model GerenciadorTarefas.MVC.Models.Tarefa

<h1>Editar Tarefa</h1>

<div asp-validation-summary="All" style="color: red;"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Título</label>
        <input type="text" asp-for="Titulo" />
        <span asp-validation-for="Titulo" style="color: red;"></span>
    </div>
    <div>
        <label>Descrição</label>
        <textarea asp-for="Descricao"></textarea>
        <span asp-validation-for="Descricao" style="color: red;"></span>
    </div>
    <div>
        <label>Data</label>
        <input type="date" asp-for="Data" />
        <span asp-validation-for="Data" style="color: red;"></span>
    </div>
    <div>
        <label>
            <input type="checkbox" asp-for="Concluida" /> Concluída
        </label>
    </div>
    <button type="submit">Salvar</button>
</form>