@model GerenciadorTarefas.MVC.ViewModels.CadastroViewModel

<h1>Criar conta</h1>

<div asp-validation-summary="All" style="color: red;"></div>

<form asp-action="Registro" method="post">
    <div>
        <label>Nome</label>
        <input type="text" asp-for="Nome" />
        <span asp-validation-for="Nome" style="color: red;"></span>
    </div>
    <div>
        <label>E-mail</label>
        <input type="email" asp-for="Email" />
        <span asp-validation-for="Email" style="color: red;"></span>
    </div>
    <div>
        <label>Senha</label>
        <input type="password" asp-for="Senha" />
        <span asp-validation-for="Senha" style="color: red;"></span>
    </div>
    <button type="submit">Cadastrar</button>
</form>

<p><a asp-action="Login">Já tenho conta</a></p>